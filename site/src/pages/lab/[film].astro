---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductFilm from '../../components/ProductFilm.astro';
import { FILMS, PUBLIC_ORIGIN, FILM_PUBLISHED } from '../../data/films';

export function getStaticPaths() {
  return (['cortex', 'neuron'] as const).map((film) => ({ params: { film }, props: { film } }));
}
const { film } = Astro.props as { film: 'cortex' | 'neuron' };
const item = FILMS[film];
const other = film === 'cortex' ? 'neuron' : 'cortex';
const url = `${PUBLIC_ORIGIN}/lab/${film}/`;
const transcript = item.transcript.map(([time, line]) => `${time} ${line}`).join('\n');
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'ExNulla', item: PUBLIC_ORIGIN },
        { '@type': 'ListItem', position: 2, name: 'Lab', item: `${PUBLIC_ORIGIN}/lab/` },
        { '@type': 'ListItem', position: 3, name: item.name, item: url },
      ],
    },
    {
      '@type': 'VideoObject',
      '@id': `${url}#film`,
      name: `${item.name} — ${item.title}`,
      description: `${item.description} Illustrative product film; no audio.`,
      thumbnailUrl: [`${PUBLIC_ORIGIN}/assets/films/${film}-poster.jpg`],
      uploadDate: FILM_PUBLISHED,
      duration: `PT${item.duration}S`,
      contentUrl: `${PUBLIC_ORIGIN}/assets/films/${film}.mp4`,
      inLanguage: 'en',
      transcript,
      creator: { '@id': `${PUBLIC_ORIGIN}/#james-huson`, '@type': 'Person', name: 'James Huson' },
      isPartOf: { '@type': 'WebPage', '@id': url, name: `${item.name} product film` },
    },
  ],
};
---

<BaseLayout
  title={`${item.name} — ${item.eyebrow} | James Huson, ExNulla`}
  description={item.description}
  image={`/assets/films/${film}-poster.jpg`}
  active="lab"
>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/lab">Lab</a><span aria-hidden="true">/</span><span>{item.name}</span>
  </nav>
  <div class="film-intro">
    <div>
      <div class="kicker">{item.eyebrow}</div><h1 class="h1">
        {item.name}<span aria-hidden="true">.</span>
      </h1>
    </div>
    <p>{item.title}<br /><span>A research project by James Huson.</span></p>
  </div>
  <ProductFilm film={film} />
  <p class="sub film-summary">{item.summary}</p>

  <section class="editorial">
    <div><div class="kicker">The question</div><h2>{item.question}</h2></div>
    <div><p>{item.approach}</p><p class="small">{item.status}</p></div>
  </section>

  <section class="editorial">
    <div>
      <div class="kicker">Engineering behind the work</div><h2>
        From concept to a working system.
      </h2>
    </div>
    <div>
      <p>{item.engineering}</p><div class="pillrow">
        {item.skills.map((skill) => <span class="pill">{skill}</span>)}
      </div>
      <p class="small">
        James Huson’s work spans the system concept, architecture, development direction, and
        validation of these research projects, using AI-assisted development.
      </p>
      <a class="text-link" href="/cv"
        >See the skills and experience <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>

  <section class="editorial" id="transcript">
    <div>
      <div class="kicker">Film transcript</div><h2>The story in words.</h2><p class="small">
        Silent film. All main titles are reproduced here.
      </p>
    </div>
    <ol class="transcript">
      {
        item.transcript.map(([time, line]) => (
          <li>
            <>
              <time>{time}</time>
              <p>{line}</p>
            </>
          </li>
        ))
      }
    </ol>
  </section>
  <div class="film-cta">
    <div><div class="kicker">Continue exploring</div><h2>Interested in the work?</h2></div><div
      class="btnrow"
    >
      <a class="btn primary" href="/contact">Start a conversation</a><a
        class="btn ghost"
        href={`/lab/${other}`}>Explore {FILMS[other].name} <span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  <style>
    .breadcrumbs {
      display: flex;
      gap: 12px;
      color: var(--muted);
      font-size: 13px;
      margin: 6px 0 34px;
    }
    .breadcrumbs a {
      text-underline-offset: 4px;
    }
    .film-intro {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 28px;
    }
    .film-intro .h1 {
      font-size: clamp(52px, 8vw, 88px);
      font-weight: 550;
      letter-spacing: -0.055em;
      margin-bottom: 0;
    }
    .h1 span {
      color: #7de0c8;
    }
    .film-intro p {
      margin: 0 0 4px;
      font-size: 21px;
    }
    .film-intro p span {
      font-size: 13px;
      color: var(--muted);
    }
    .film-summary {
      max-width: 780px;
      margin: 32px 0 48px;
      font-size: 23px;
    }
    .editorial {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 60px;
      padding: 36px 0;
      border-top: 1px solid var(--border);
      scroll-margin-top: 100px;
    }
    .editorial h2 {
      font-size: 28px;
      letter-spacing: -0.025em;
      font-weight: 550;
      line-height: 1.25;
      margin: 14px 0;
      max-width: 22ch;
    }
    .editorial p {
      margin-top: 0;
    }
    .editorial .small {
      margin-top: 20px;
    }
    .text-link {
      color: #b8eddf;
      text-underline-offset: 5px;
      font-size: 14px;
    }
    .transcript {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .transcript li {
      display: grid;
      grid-template-columns: 50px 1fr;
      gap: 14px;
      margin-bottom: 20px;
    }
    .transcript time {
      color: #83cdbd;
      font: 12px monospace;
      padding-top: 3px;
    }
    .transcript p {
      font-size: 14px;
      color: var(--muted);
    }
    .film-cta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      border-top: 1px solid var(--border);
      padding: 36px 0 0;
    }
    .film-cta h2 {
      margin: 8px 0;
      font-size: 28px;
      font-weight: 550;
    }
    @media (max-width: 680px) {
      .film-intro,
      .film-cta {
        align-items: start;
        flex-direction: column;
      }
      .film-intro {
        gap: 12px;
      }
      .editorial {
        grid-template-columns: 1fr;
        gap: 16px;
        padding: 28px 0;
      }
      .film-summary {
        font-size: 19px;
      }
    }
  </style>
</BaseLayout>
