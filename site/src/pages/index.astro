---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS } from '../components/siteConfig';
import ProductFilm from '../components/ProductFilm.astro';
import FilmCards from '../components/FilmCards.astro';
---

<BaseLayout
  title="James Huson — Applied AI Systems Engineer | ExNulla"
  description="James Huson, Applied AI Systems Engineer. Explore Cortex for persistent AI context, Neuron for symbolic computing, and case studies in governed agent systems."
  image="/assets/films/overview-poster.jpg"
  active=""
  type="profile"
>
  <div class="landing-intro">
    <div class="intro-copy">
      <div class="kicker">James Huson · Applied AI Systems Engineer</div>
      <h1 class="h1">I build AI systems that teams can trust in production.</h1>

      <p class="sub">
        I design and ship auditable agent systems, governed tool execution, deterministic workflows,
        and delivery infrastructure. Explore the systems, the research, and the engineering behind
        the work.
      </p>

      <div class="btnrow">
        <a class="btn primary" href="/cv">View CV</a>
        <a class="btn ghost" href="/projects">Case Studies</a>
        <a class="btn ghost" href="/lab">Explore the Lab</a>
      </div>
    </div>
    <div class="intro-film">
      <div class="film-heading"><span>From the lab</span><span>Cortex + Neuron / 2026</span></div>
      <ProductFilm film="overview" />
    </div>
  </div>

  <section class="featured-research" aria-label="Featured research projects">
    <div class="research-heading">
      <span>Independent research. Working systems.</span><a href="/lab#product-films"
        >Explore the films <span aria-hidden="true">↗</span></a
      >
    </div>
    <FilmCards />
  </section>

  <div class="hr"></div>

  <section class="grid grid-2">
    <div>
      <h2>What I build</h2>
      <p>
        AI features become useful when they are connected to real workflows and bounded by clear
        contracts. I build the layer around the model: schemas, tools, state, validation, security,
        observability, and deployment.
      </p>
      <p>
        My work sits between applied AI engineering, platform architecture, and operational
        delivery: turning uncertain model output into inspectable systems that can be tested,
        operated, and improved.
      </p>
    </div>

    <div class="card">
      <h2>What you will find here</h2>
      <ul class="list">
        <li>
          <strong>Case studies:</strong> real constraints, architecture decisions, and shipped proof.
        </li>
        <li>
          <strong>CV:</strong> the skills, systems, and role fit behind the work.
        </li>
        <li><strong>Lab:</strong> product films and sandboxed demos that make the work visible.</li>
        <li>
          <strong>Engineering:</strong> the design and delivery practices behind the systems.
        </li>
      </ul>
    </div>
  </section>

  <div class="hr"></div>

  <section>
    <h2>How I can help a team</h2>
    <div class="grid grid-3">
      <article class="card">
        <h2 style="font-size:18px; margin:0 0 8px">AI platform design</h2>
        <p class="small" style="margin:0 0 12px">
          Agent orchestration, tool boundaries, RAG/context flows, validation, observability, and
          governance that survive beyond the prototype.
        </p>
        <div class="btnrow">
          <a class="btn ghost" href="/projects">See case studies</a>
        </div>
      </article>

      <article class="card">
        <h2 style="font-size:18px; margin:0 0 8px">Systems delivery</h2>
        <p class="small" style="margin:0 0 12px">
          TypeScript, Node, Python, PostgreSQL, CI/CD, cloud deployment, release discipline, and
          recovery-minded operations.
        </p>
        <div class="btnrow">
          <a class="btn ghost" href="/cv">View experience</a>
        </div>
      </article>

      <article class="card">
        <h2 style="font-size:18px; margin:0 0 8px">Trustworthy AI</h2>
        <p class="small" style="margin:0 0 12px">
          Schema gates, threat modeling, prompt-injection resistance, audit trails, deterministic
          fallbacks, and human accountability around model output.
        </p>
        <div class="btnrow">
          <a class="btn ghost" href="/lab">Open Lab</a>
        </div>
      </article>
    </div>
  </section>

  <div class="hr"></div>

  <section class="card">
    <div class="kicker">Featured case</div>
    <h2 style="margin-top:4px">Nexus — Policy-Aware Action Router + Authority Governance Layer</h2>
    <p>
      A TypeScript/Node authorization gateway for AI agents: identity and vault-backed credentials,
      an MCP (Model Context Protocol) adapter, and a 10-scenario policy test suite covering approval
      workflows, delegation limits, replay-attack detection, and default-deny access control --
      schemas, authority boundaries, deterministic gates, audit records, and CI enforcement
      throughout.
    </p>
    <p class="small">
      This is the kind of work I want to be known for: making AI useful without making it
      unaccountable.
    </p>
    <div class="btnrow">
      <a class="btn ghost" href="/projects/nexus">View case study</a>
      <a
        class="btn ghost"
        href="https://github.com/Thesis-Web/nexus"
        target="_blank"
        rel="noreferrer">Open GitHub</a
      >
    </div>
  </section>

  <div class="hr"></div>

  <section class="grid grid-2">
    <div class="card">
      <h2>Built end to end</h2>
      <p class="small" style="margin:0 0 12px">
        ExNulla is a working reference implementation of how I operate: define the problem, lock the
        constraints, build the smallest useful system, verify it, deploy it, and document the
        trade-offs.
      </p>
      <ul class="list">
        <li>Architecture, implementation, deployment, and operations in one loop.</li>
        <li>Static-first shell with atomic releases and sandboxed demo windows.</li>
        <li>Public source and runnable proof wherever confidentiality allows.</li>
      </ul>
    </div>

    <div class="card">
      <h2>Operating stance</h2>
      <ul class="list">
        <li>Start with limits, not features.</li>
        <li>Prefer systems that are inspectable, testable, and cheap to recover.</li>
        <li>Use AI aggressively, but keep judgment and accountability human.</li>
        <li>Move fast where ambiguity is low; slow down where the architecture matters.</li>
      </ul>
      <p class="small" style="margin-top:12px">
        The goal is simple: make the work legible to the people hiring for applied AI, platform, and
        systems delivery.
      </p>
    </div>
  </section>

  <div class="hr"></div>

  <section class="identity">
    <div class="identity-inner">
      <img src="/assets/James-Headshot.jpg" alt="James Huson" loading="lazy" />
      <div>
        <strong>James Huson</strong>
        <div class="small">Developer architecture, systems thinking, and public proof-of-work.</div>
      </div>
    </div>

    <div class="btnrow" style="justify-content:center;">
      <a class="btn ghost" href={LINKS.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="btn ghost" href="https://github.com/Thesis-Web" target="_blank" rel="noreferrer"
        >GitHub</a
      >
    </div>
  </section>

  <style>
    .landing-intro {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
      gap: 44px;
      padding: 30px 0 34px;
    }
    .intro-copy .kicker {
      font-size: 10px;
      letter-spacing: 0.09em;
    }
    .intro-copy .h1 {
      font-size: clamp(36px, 3.6vw, 48px);
      letter-spacing: -0.045em;
      line-height: 1.08;
      font-weight: 600;
      margin: 18px 0;
    }
    .intro-copy .sub {
      font-size: 16px;
      line-height: 1.7;
    }
    .intro-copy .btn {
      font-size: 12px;
      padding: 10px 12px;
    }
    .film-heading,
    .research-heading {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .film-heading {
      margin: 0 0 13px;
    }
    .film-heading span:first-child {
      color: #9de0cd;
    }
    .featured-research {
      padding: 20px 0 28px;
    }
    .research-heading {
      margin-bottom: 18px;
    }
    .research-heading a {
      text-transform: none;
      letter-spacing: 0;
      text-underline-offset: 4px;
    }
    @media (max-width: 900px) {
      .landing-intro {
        grid-template-columns: 1fr;
        gap: 28px;
        padding-top: 12px;
      }
      .intro-copy .h1 {
        max-width: 19ch;
        font-size: clamp(36px, 6vw, 50px);
      }
      .intro-copy .sub {
        max-width: 65ch;
      }
    }
    @media (max-width: 480px) {
      .research-heading {
        font-size: 9px;
      }
      .film-heading {
        font-size: 9px;
      }
    }
    .identity {
      display: grid;
      gap: 18px;
      justify-items: center;
      text-align: center;
    }

    .identity-inner {
      display: grid;
      gap: 14px;
      justify-items: center;
      width: 100%;
    }

    .identity-inner img {
      width: min(100%, 360px);
      aspect-ratio: 4 / 5;
      object-fit: cover;
      object-position: center top;
      border-radius: 18px;
      border: 1px solid var(--border);
      display: block;
    }

    @media (max-width: 640px) {
      .identity-inner img {
        width: min(100%, 300px);
      }

      .identity .btnrow {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        width: 100%;
        justify-content: stretch !important;
      }

      .identity .btnrow .btn {
        width: 100%;
      }

      .identity .btnrow .btn:last-child {
        grid-column: 1 / -1;
      }
    }
  </style>
</BaseLayout>
